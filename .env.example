# Copy to .env for local development. Never commit real keys.

# --- API (services/api) ---
HARBOR_ENV=dev
HARBOR_LOG_JSON=false
HARBOR_DATABASE_URL=postgresql+asyncpg://harbor:harbor@localhost:5432/harbor
HARBOR_REDIS_URL=redis://localhost:6379/0

# --- Web (apps/web) ---
HARBOR_API_URL=http://localhost:8000

